# Copy to .env or export these variables in your shell.
# The files below are intentionally outside the public repository.
APPWORLD_MODEL=models/Qwen3.5-4B-sft-final
APPWORLD_ROOT=artifacts/appworld_rl_v1_root
APPWORLD_GRPO_TRAIN=artifacts/appworld_grpo/train_custom.parquet
APPWORLD_GRPO_VAL=artifacts/appworld_grpo/dev_custom.parquet
APPWORLD_GRPO_OUTPUT=artifacts/appworld_grpo/checkpoints_formal
APPWORLD_EVAL_OUTPUT=artifacts/evaluations/appworld_grpo_formal
PYTHON_BIN=python
EVAL_PYTHON=python
# Optional when a merged RL checkpoint contains weights/config but no tokenizer.
EVAL_TOKENIZER_PATH=models/Qwen3.5-4B-sft-final
WANDB_MODE=offline
# Required only for teacher collection:
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_API_KEY=replace-me
